      ]
    },
    {
      "id": "C:RGV20261013:metadata",
      "type": "metadata_correction",
      "status": "verified_additive_post_read_correction",
      "label": "Vc is consensus gas velocity; S/A/B designation is the native Name suffix",
      "text": "The original output mislabels the literal Vc string as native_velocity_component. The additive corrected assessment fixes field meaning and preserves original summary/code/check bytes. Vc never entered any primary band or decision; no measurement or rule changed.",
