    {
      "id": "C:RGV20261013:limits",
      "type": "qualification",
      "status": "physical_association_and_youth_unestablished",
      "label": "Wing overlap is sensitive, not a confirmed clump or stellar association",
      "text": "The +1 km/s declared shift removes overlap. Shifts are arbitrary sensitivity scenarios, not calibration bounds. The maser peak is outside both registered gas bands. No stellar velocity, calibrated association probability, physical youth, membership, birth or representative truth is established. Other two cases are secondary contextual examples, not verified unrelated controls. Case selection, radio and molecular measurements are consumed; no scores or old gates changed.",
      "sources": [
        "docs/RADIO_GAS_VELOCITY_RESULTS_20261013.md",
        "artifacts/radio_gas_velocity_checkpoint_20261013.json",
        "artifacts/radio_gas_velocity_corrected_assessment_20261013.json",
        "artifacts/radio_gas_velocity_analysis_20261013/summary.json",
