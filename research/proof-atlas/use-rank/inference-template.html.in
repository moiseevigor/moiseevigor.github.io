<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reading a Lean inference · Proof Atlas</title><style>
:root{color-scheme:light dark}*{box-sizing:border-box}body{max-width:48rem;margin:2rem auto;padding:0 1rem;font:1.1rem/1.5 Georgia,serif}h1,h2{line-height:1.15}h2{font-size:1.35rem}label,summary,button,select,.meta{font:1rem/1.45 system-ui}select,input,button{font:inherit;max-width:100%;padding:.3rem}.formula,a,code,summary{overflow-wrap:anywhere}.premise{padding:.6rem 0}.premise p{margin:.25rem 0}.result{border-top:2px solid;padding-top:.65rem}.choice{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap}input{width:6em}a{color:LinkText}:focus-visible{outline:2px solid currentColor;outline-offset:2px}

.matrix-scroll{overflow-x:auto;padding:.25rem}.matrix{border-collapse:collapse;font:1rem/1.4 system-ui}.matrix th,.matrix td{padding:.25rem .45rem;text-align:center}.matrix th:first-child{text-align:left;max-width:15rem;overflow-wrap:anywhere}.matrix thead{border-bottom:1px solid GrayText}.matrix tr>:last-child{border-left:1px solid GrayText}.matrix button{min-width:2.3rem;min-height:2.3rem;border:1px solid transparent;background:none;color:LinkText;cursor:pointer}.matrix button:hover,.matrix button[aria-pressed=true]{border-color:currentColor;background:ButtonFace}.matrix-key{font:1rem/1.45 system-ui}#witness{border-inline-start:2px solid GrayText;padding-inline-start:.7rem}
.premise[data-selected]{border-inline-start:3px solid LinkText;padding-inline-start:.7rem}
.branch-focus{margin:.6rem 0}.branch-focus meter{width:min(8rem,33%);margin-right:.5rem;vertical-align:middle}
.case-branches{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem}.case-branches>div{min-width:0;border-inline-start:2px solid GrayText;padding-inline-start:.7rem}.case-branches h3{margin:0}
</style></head><body><main><h1>Reading a Lean inference</h1><label>Compiled application <select id="proof"></select></label>
<p id="intro"></p><details id="final-application"><summary>Read backward from the theorem result</summary><div id="final-body"></div></details><details id="statement-flow"><summary>Trace a theorem parameter or hypothesis</summary><label>Statement binder <select id="clause"></select></label><div id="flow"></div></details><section aria-labelledby="map-heading"><h2 id="map-heading">Which arguments occur in each type?</h2>
<p class="matrix-key">Columns are proof inputs and the conclusion. Select a dot to trace its reference. A dash means the formal argument is absent from that type. A blank falls outside its scope.</p>
<div class="matrix-scroll" tabindex="0" role="region" aria-label="Argument references by premise and conclusion"><table class="matrix" id="matrix" aria-labelledby="map-heading"></table></div><p id="witness" aria-live="polite" hidden></p></section><h2>Proof arguments</h2><div id="premises"></div><section class="result"><h2>Conclusion</h2><div id="denominator" hidden><p>Clearing denominators turns the fractional equation</p>
<math display="block" aria-label="one over a plus one, plus one over b plus one, plus one over a plus b, equals three halves"><mrow><mfrac><mn>1</mn><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfrac><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></mrow></math>
<p>into the polynomial equation below. The call establishes equality of the two propositions.</p></div><p id="result" class="formula"></p><div id="result-inputs"></div><h3>Recorded uses of this result</h3><div id="consumers"></div></section>
<details id="details"><summary>Function, types and values</summary><div id="other"></div></details>
<section id="trace"><h2>Inspect a variable use</h2><p id="context"></p><form class="choice"><label>Use <input id="ordinal" required type="number" min="1" step="1"></label><button>Locate</button></form><p aria-live="polite"><a id="occurrence">Open compiled occurrence</a></p></section>
<details><summary>Compiled provenance</summary><p id="identity" class="meta"></p></details></main>
<script>/* SELECTOR */
const examples=/* EXAMPLES */;
const finalApplications=/* FINALS */;
const typeContexts=/* TYPE CONTEXTS */;
const groupBindings=/* GROUP BINDINGS */;
const flows=/* FLOWS */;
const el=id=>document.getElementById(id);
let active,port;
function address(hit) {
 const url=new URL('https://moiseevigor.github.io/projects/proof-atlas/library/');
 url.search=new URLSearchParams({edition:active.source.edition,proof:active.source.name,route:hit.route.root+':'+hit.route.slots.join('.')});
 url.hash='expr-'+hit.node;return url.href;
}
function link(text,hit){const a=document.createElement('a');a.textContent=text;a.href=address(hit);return a;}
function locate(n){
 const hit=selectBranch(active.table,BigInt(port.offset)+n);
 const a=el('occurrence');a.href=address({node:hit.node,route:{root:active.call.route.root,slots:hit.slots}});
 a.textContent='Open use '+n+' of '+port.count+' in input '+port.slot+' · expression '+hit.node;
}
function choose(p){
 el('trace').hidden=false;port=p;el('context').textContent='Input '+p.slot+' contains '+p.count+' direct uses of '+active.variable+'.';
 el('ordinal').value='1';el('ordinal').max=p.count;locate(1n);
}
function typeInputs(p,result=false){
 const detail=document.createElement('details'),title=document.createElement('summary');
 title.textContent=result?'Arguments in the rule’s result type':'Earlier arguments in the expected type';detail.append(title);
 if(p.dependencies===null){detail.append('Formal type structure unavailable.');return detail;}
 if(!p.dependencies.length){detail.append('No supplied argument occurs here.');return detail;}
 const list=document.createElement('ul');
 for(const witness of p.dependencies){
  const target=active.ports[witness.slot],row=document.createElement('li');
  const name=target.formalName||'argument';
  row.append(link(name+' · input '+target.slot,target.input));
  const path=document.createElement('code');
  path.textContent=witness.root+'.'+witness.slots.join('.')+' · row '+witness.node;
  row.append(' · function type occurrence ',path);list.append(row);
 }
 detail.append(list);return detail;
}
function premiseName(slot){
 if(active.source.name==='lean_workbook_plus_15068' && active.callId===2){
  return ({9:'Left factorization',10:'Right factorization',11:'Nonzero factor'})[slot];
 }
}
function renderMatrix(){
 const table=el('matrix'),readout=el('witness');table.replaceChildren();readout.replaceChildren();readout.hidden=true;
 const columns=active.ports.filter(p=>p.role==='proof').map(p=>({label:'Input '+p.slot,slot:p.slot,refs:p.dependencies,anchor:p.input}));
 columns.push({label:'Conclusion',slot:active.ports.length,refs:active.resultDependencies,anchor:active.call});
 const header=table.createTHead().insertRow(),body=table.createTBody();
 function heading(row,text,scope){const th=document.createElement('th');th.scope=scope;th.textContent=text;row.append(th);}
 heading(header,'Formal argument','col');
 for(const column of columns)heading(header,premiseName(column.slot)||column.label,'col');
 let selected=null;
 for(const p of active.ports.slice(1)){
  const row=body.insertRow();
  const name=p.formalName?.startsWith('inst._@')?'instance':p.formalName||p.role;
  heading(row,name+' ('+p.slot+')','row');
  for(const col of columns){
   const cell=row.insertCell();
   if(p.slot>=col.slot){cell.setAttribute('aria-label','Outside scope');continue;}
   if(col.refs===null){cell.textContent='?';cell.setAttribute('aria-label','Type unavailable');continue;}
   const w=col.refs.find(edge=>edge.slot===p.slot);
   if(!w){cell.textContent='–';cell.setAttribute('aria-label','Absent');continue;}
   const button=document.createElement('button');
   button.type='button';button.textContent='●';button.setAttribute('aria-label',name+' (input '+p.slot+') in '+col.label);
   button.setAttribute('aria-pressed','false');cell.append(button);
   button.onclick=()=>{
    if(selected)selected.setAttribute('aria-pressed','false');
    selected=button;selected.setAttribute('aria-pressed','true');
    const path=document.createElement('code');path.textContent=w.root+'.'+w.slots.join('.')+' · row '+w.node;
    readout.replaceChildren(link(name+' · input '+p.slot,p.input),' occurs in the formal type for ',link(premiseName(col.slot)||col.label,col.anchor),'. Function type occurrence ',path);readout.hidden=false;
   };
  }
 }
}
function showBinding(box,p){
 if(p.binding){
  const line=document.createElement('p');line.append('Bound by ',link(p.binding.name||'enclosing binder',p.binding.anchor));box.append(line);
  const detail=document.createElement('details'),title=document.createElement('summary');
  detail.className='declared-domain';title.textContent='Declared type of '+p.binding.name;detail.append(title);
  detail.append(link('Type at the proof binder',p.binding.domain));
  if(p.binding.statement)detail.append(' · ',link('Matching theorem hypothesis or parameter type',p.binding.statement));
  else detail.append(' · No paired theorem binder recorded.');
  if(p.binding.references===null)detail.append(' · Variable references unavailable.');
  else if(!p.binding.references.length)detail.append(' · No enclosing variable occurs in this type.');
  else{
   const list=document.createElement('ul');
   for(const ref of p.binding.references){
    const li=document.createElement('li');li.append(link(ref.name,ref.binder),' · '+ref.count+(ref.count==='1'?' occurrence':' occurrences')+' · ',link('Inspect first occurrence',ref.use));list.append(li);
   }
   detail.append(list);
  }
  box.append(detail);
 }
 if(!p.resolution)return;
 const r=p.resolution,detail=document.createElement('details'),title=document.createElement('summary');
 detail.className='definition';title.textContent='Follow local definition '+r.inputTerm;detail.append(title);
 const steps=document.createElement('ol');
 for(const h of r.definitions){
  const step=document.createElement('li');step.append(link('Reference to '+h.name,h.use),' → ',link('let '+h.name,h.binder),' → ',link('defining value',h.value));steps.append(step);
 }
 detail.append(steps);
 const caption=document.createElement('p');
 caption.textContent=r.inputTerm+' resolves to '+r.valueTerm+'. Local context: '+r.inputContext+' binders at the reference, '+r.valueContext+' at the value.';
 detail.append(caption);
 if(r.boundary)detail.append('Further local-definition resolution is unavailable.');
 box.append(detail);
}
function traceClause(){
 const clause=flows[active.source.indexSha256][Number(el('clause').value)],area=el('flow');
 area.replaceChildren(link('Open declared type of '+clause.name,clause.domain));
 const note=document.createElement('p');note.textContent=clause.containing.length+' recorded call subtrees contain a lexical reference to this binder. A direct input supplies the binder itself.';area.append(note);
 const coverage=document.createElement('p'),c=clause.coverage;
 coverage.className='coverage';
 coverage.append(c.total==='0'?'The binder has no lexical uses in its proof body.':c.covered+' of '+c.total+' uses in the binder body lie inside the recorded calls, counting each occurrence once.');
 if(c.firstOutside)coverage.append(' ',link('Inspect first use outside the recorded calls',c.firstOutside));
 area.append(coverage);
 if(c.branches.regions){
  const panel=document.createElement('details'),heading=document.createElement('summary'),list=document.createElement('ol');
  panel.className='outside-branches';
  heading.textContent='Largest uncovered branches ('+c.branches.largest.length+' of '+c.branches.regions+')';
  for(const b of c.branches.largest){
   const row=document.createElement('li');
   row.append(link(b.kind+' · '+b.count+' uses',b.anchor),' · ',link('First occurrence',b.first));
   const size=document.createElement('p');size.textContent=b.expressions+' expression occurrences · '+b.sourceRows+' distinct stored rows';row.append(size);
   if(b.head){const rule=document.createElement('p');rule.append('Function ',link(b.head.label,b.head.anchor),' · '+b.head.arguments+' supplied arguments');row.append(rule);}
   const fields=document.createElement('details'),title=document.createElement('summary');title.textContent='Inspect structural fields';fields.append(title);
   if(b.fields.length){
    const children=document.createElement('ul');
    for(const f of b.fields){const child=document.createElement('li');child.append(link(f.field,f.anchor),' · '+f.uses+' binder uses in '+f.expressions+' expression occurrences');children.append(child);}
    fields.append(children);row.append(fields);
   }
   const stop=b.stop,focus=document.createElement('div');focus.className='branch-focus';
   const label=stop.children.length?'First split':'Variable occurrence';
   focus.append(link(label,stop.anchor),' · '+stop.steps+' fields below the branch root · '+stop.expressions+' expression occurrences');
   for(const child of stop.children){
    const line=document.createElement('div'),meter=document.createElement('meter');
    meter.max=1000000;meter.value=Number(BigInt(child.count)*1000000n/BigInt(b.count));meter.setAttribute('aria-hidden','true');
    line.append(meter,link(child.field,child.anchor),' · '+child.count+' of '+b.count+' uses');focus.append(line);
   }
   row.append(focus);
   if(b.frontier.length){
    const groups=document.createElement('details'),title=document.createElement('summary');
    groups.className='branch-groups';title.textContent=b.frontier.length===1?'Inspect subtree inputs':'Partition into '+b.frontier.length+' subtrees';groups.append(title);
    for(const part of b.frontier){
     const line=document.createElement('p'),bar=document.createElement('meter');
     bar.max=1000000;bar.value=Number(BigInt(part.count)*1000000n/BigInt(b.count));bar.setAttribute('aria-hidden','true');
     line.append(bar,' ',link(part.fields||'Branch root',part.anchor),' · '+part.count+' of '+b.count+' uses');groups.append(line);
     const refs=groupBindings[active.source.indexSha256][part.anchor.route.slots.join('.')];
     const panel=document.createElement('details'),caption=document.createElement('summary');panel.className='group-inputs';
     caption.textContent=refs===null?'Enclosing binder references unavailable':'Enclosing binders ('+refs.length+')';panel.append(caption);
     for(const ref of refs||[]){
      const entry=document.createElement('p');entry.append(link(ref.name,ref.binder),' · '+ref.count+' uses · ',link('First use',ref.use));panel.append(entry);
     }
     const extra=typeContexts[active.source.indexSha256][part.anchor.route.slots.join('.')];
     if(extra===null)panel.append('Binder type dependencies unavailable.');
     else if(extra.length){
      const detail=document.createElement('details'),heading=document.createElement('summary');
      detail.className='type-context';heading.textContent='Additional variables used in binder types ('+extra.length+')';detail.append(heading);
      const list=document.createElement('ul');detail.append(list);
      for(const item of extra){
       const row=document.createElement('li');
       row.append(link(item.name,item.binder),' occurs in ',link('the type of '+item.owner,item.domain),' · ',link('Inspect reference',item.use));
       list.append(row);
      }
      panel.append(detail);
     }
     groups.append(panel);
    }
    row.append(groups);
   }
   const path=document.createElement('code');path.textContent=b.path;row.append(path);list.append(row);
  }
  panel.append(heading,list);area.append(panel);
 }
 if(clause.containing.length){
  const detail=document.createElement('details'),title=document.createElement('summary'),list=document.createElement('ul');
  title.textContent='Inspect occurrences inside calls';detail.append(title,list);
  for(const c of clause.containing){const row=document.createElement('li');row.append(link('Call '+c.call+' · first of '+c.count,c.first));list.append(row);}
  area.append(detail);
 }
 for(const [heading,edges] of [['Inputs supplied by this binder',clause.direct],['Inputs supplied by a reached call result',clause.subsequent]]){
  const title=document.createElement('h3');title.textContent=heading;area.append(title);
  if(!edges.length){area.append('None in the recorded calls.');continue;}
  const list=document.createElement('ul');
  for(const e of edges){
   const row=document.createElement('li'),a=document.createElement('a');
   a.href='#'+active.source.indexSha256+'-'+e.call+'/input/'+e.slot;
   a.textContent='Call '+e.call+' · input '+e.slot;
   if(e.from!==undefined)row.append('Result of call '+e.from+' → ');
   row.append(a);list.append(row);
  }
  area.append(list);
 }
}
el('clause').onchange=traceClause;
function showFinal(){
 const hash=active.source.indexSha256,f=finalApplications[hash],host=el('final-body');
 host.replaceChildren(link('Final proof expression',f.anchor));
 if(!f.checked){host.append(' · Application trace unavailable.');return;}
 const formula=document.createElement('p');formula.className='formula';formula.textContent=f.type;
 host.append(' · ',link(f.rule,f.head),formula);
 const other=document.createElement('details'),label=document.createElement('summary');
 const cases=f.cases?.checked?f.cases:null,branches=document.createElement('div');
 branches.className='case-branches';
 if(f.cases && !cases)host.append(' No checked constructor mapping at this occurrence.');
 label.textContent='Type and value arguments';other.append(label);
 for(const arg of f.args){
  const box=document.createElement('div'),p=document.createElement('p');box.className='formula';box.dataset.finalSlot=arg.slot;
  p.append('Input '+arg.slot+' · '+arg.role+' · ',link(arg.type,arg.anchor));box.append(p);
  const branch=cases?.branches.find(b=>b.slot===arg.slot);
  if(cases?.major===arg.slot){
   const title=document.createElement('h3');title.textContent=cases.recursor==='Or.rec'?'Disjunction used for the split':'Input to the case split';box.prepend(title);
   if(cases.origin)box.append('Local result ',link(cases.origin.name,cases.origin.binder),' · ',link('Defining proof',cases.origin.value));
  }
  if(branch){
   const title=document.createElement('h3');title.textContent=branch.constructor;box.prepend(title);
   for(const d of branch.domains)box.append(link('Assumption',d),' · ');
   box.append(link('Branch body',branch.body),' · head ',link(branch.head.label,branch.head));
   for(const uses of branch.assumptionUses){
    const group=document.createElement('div');group.className='case-uses';
    group.append(link('Case binder',uses.binder),' · '+uses.total+(uses.total==='1'?' reference':' references')+' in this body');
    const list=document.createElement('ul');
    for(const part of uses.parts.filter(p=>p.first)){
     const row=document.createElement('li');
     row.append(link(part.slot?'Input '+part.slot:'Function',part.anchor),' · '+part.count+' · ',link('First reference',part.first));
     list.append(row);
    }
    group.append(list);box.append(group);
   }
   if(branch.head.label==='Or.casesOn' && !branch.bodyEliminationChecked){
    const note=document.createElement('p');note.textContent='Nested call shown in source argument order. No checked constructor mapping at this occurrence.';box.append(note);
   }
  }
  function callList(calls){
   const list=document.createElement('ul');
   for(const call of calls){
    const li=document.createElement('li'),a=document.createElement('a');
    a.href='#'+hash+'-'+call.id+'/read';a.textContent='Inspect '+call.rule+' · call '+call.id;
    a.onclick=e=>{if(a.hash===location.hash){e.preventDefault();follow();}};
    li.append(a);list.append(li);
   }
   return list;
  }
  if(arg.calls.length)box.append('Recorded calls inside this argument',callList(arg.calls));
  for(const local of arg.viaLocal||[]){
   const segment=document.createElement('div');segment.className='via-local';
   segment.append('Via ',link(local.name,local.binder),' · ',link('use in this argument',local.use),' · ',
    link('defining value',local.value),callList(local.calls));
   box.append(segment);
  }
  if(arg.localLinksIncomplete)box.append('Local definition links incomplete.');
  (branch?branches:arg.role==='proof'?host:other).append(box);
 }
 if(branches.children.length)host.append(branches);
 if(other.children.length>1)host.append(other);
}
function show(i){
 const previous=active?.source.indexSha256;
 active=examples[i];
 if(previous!==active.source.indexSha256){
  showFinal();
  const clauses=flows[active.source.indexSha256],picker=el('clause');
  picker.replaceChildren();
  for(const [k,clause] of clauses.entries()){
   const option=document.createElement('option');option.value=k;option.textContent=clause.name+' · binder '+(k+1);picker.append(option);
  }
  picker.value=String(Math.max(0,clauses.findIndex(c=>c.direct.length)));
  el('statement-flow').hidden=!clauses.length;
  if(clauses.length)traceClause();
 }
 renderMatrix();el('details').open=false;
 el('intro').replaceChildren('Rule ',link(active.rule,active.ports[0].input),'. Tracing the bound variable ',link(active.variable,active.binder),'.');
 el('identity').textContent=active.source.edition+' · source '+active.source.indexSha256+' · native observations '+active.nativeOwner;
 const denominator=active.source.name==='lean_workbook_plus_15068' && active.callId===2;
 el('denominator').hidden=!denominator;
 el('result').replaceChildren(link(active.conclusion,active.call));
 const uses=el('consumers');uses.replaceChildren();
 if(!active.consumers.length)uses.textContent='No consuming input is recorded in this inventory.';
 else{
  const list=document.createElement('ul');
  for(const use of active.consumers){
   const item=document.createElement('li'),a=document.createElement('a');
   a.href='#'+active.source.indexSha256+'-'+use.callId+'/input/'+use.slot;
   a.textContent='Call '+use.callId+' · input '+use.slot+(use.hops?' via local definition':'');
   item.append(a);list.append(item);
  }
  uses.append(list);
 }
 el('result-inputs').replaceChildren(typeInputs({dependencies:active.resultDependencies},true));
 el('premises').replaceChildren();el('other').replaceChildren();
 for(const p of active.ports){
  const box=document.createElement('div'),caption=document.createElement('p'),expr=document.createElement('p');
  box.dataset.slot=p.slot;box.className='premise';caption.className='meta';expr.className='formula';
  caption.textContent='Input '+p.slot+' · '+p.role+' · '+p.count+' uses of '+active.variable;
  if(premiseName(p.slot))caption.textContent=premiseName(p.slot)+' · '+caption.textContent;
  expr.append(link(p.text,p.input));box.append(caption,expr);if(p.slot)box.append(typeInputs(p));showBinding(box,p);
  if(p.head && (p.head.route.slots.length > p.input.route.slots.length || p.head.body)){
   const line=document.createElement('p');line.className='input-head';
   line.append('Head of input · ',link(p.head.label,p.head));
   if(p.head.binder)line.append(' · bound by ',link(p.head.binder.name||'binder',p.head.binder));
   if(p.head.body)line.append(' · ',link('Open body',p.head.body));
   box.append(line);
  }
  if(p.origin){
   const a=document.createElement('a');a.href='#'+active.source.indexSha256+'-'+p.origin.callId;
   a.textContent='Read producing call '+p.origin.callId+(p.origin.hops?' via local definition':'');
   const line=document.createElement('p');line.append(a);box.append(line);
  }
  if(BigInt(p.count)){const b=document.createElement('button');b.textContent='Inspect input '+p.slot;
   b.onclick=()=>{choose(p);el('ordinal').focus();};box.append(b);}
  el(p.role==='proof'?'premises':'other').append(box);
 }
 const first=active.ports.find(p=>p.role==='proof' && BigInt(p.count))||active.ports.find(p=>BigInt(p.count));
 el('trace').hidden=!first;
 if(first)choose(first);
 else{port=null;el('intro').append(' This application contains no direct uses of '+active.variable+'.');el('occurrence').removeAttribute('href');}
 if(!active.ports.some(p=>p.role==='proof'))el('premises').textContent='This application takes no proof-valued argument.';
}
const groups=new Map();
for(const [i,x] of examples.entries()){
 const name=x.source.name;
 if(!groups.has(name)){const group=document.createElement('optgroup');group.label=name;groups.set(name,group);el('proof').append(group);}
 const option=document.createElement('option');option.value=i;option.textContent='Call '+x.callId+' · '+x.rule;
 groups.get(name).append(option);
}
const defaultProof=examples.findIndex(x=>x.source.name==='lean_workbook_plus_15068' && x.callId===2);
function follow(){
 const [callHash,field,slot]=location.hash.split('/');
 const index=examples.findIndex(x=>callHash==='#'+x.source.indexSha256+'-'+x.callId);
 el('proof').value=String(index>=0?index:defaultProof);show(Number(el('proof').value));
 if(index>=0 && field==='final'){
  const final=el('final-application');final.open=true;final.querySelector('summary').focus();
 }
 if(index>=0 && field==='read'){
  el('final-application').open=false;
  el('intro').tabIndex=-1;el('intro').focus();
 }
 if(index>=0 && field==='input' && /^(0|[1-9]\d*)$/.test(slot)){
  const target=active.ports[Number(slot)];
  if(!target)return;
  if(target.role!=='proof')el('details').open=true;
  const box=document.querySelector('.premise[data-slot="'+slot+'"]');
  box.dataset.selected='';box.tabIndex=-1;box.focus();
  if(BigInt(target.count))choose(target);
  else{port=null;el('trace').hidden=true;el('occurrence').removeAttribute('href');}
 }
}
el('proof').onchange=e=>{const x=examples[Number(e.target.value)];location.hash=x.source.indexSha256+'-'+x.callId;};
window.addEventListener('hashchange',follow);
document.querySelector('form').onsubmit=e=>{e.preventDefault();const v=el('ordinal');if(v.validity.valid)locate(BigInt(Number(v.value)));};
follow();
</script></body></html>
