  <info><title>Proof Atlas manuscript numeric references</title><id>https://moiseevigor.github.io/projects/proof-atlas/article/</id><updated>2026-10-12T00:00:00+00:00</updated></info>
  <citation><layout prefix="[" suffix="]" delimiter="; "><group delimiter=", "><text variable="citation-number"/><text variable="locator"/></group></layout></citation>
